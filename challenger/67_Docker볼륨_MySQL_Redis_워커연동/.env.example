# cp .env.example .env 후 사용
DB_ROOT_PASSWORD=rootpw
DB_NAME=healthcare
DB_USER=health
DB_PASSWORD=healthpw

# 호스트에서 MySQL 에 붙을 때 쓰는 포트. 3306 이 이미 쓰이면 3307 등으로 바꾼다.
# 컨테이너 사이 통신은 항상 mysql:3306 을 쓰므로 영향 없다.
DB_PORT_HOST=3307

# 예약 슬롯 정원
SLOT_CAPACITY=10

# none | redis-lock | db-lock
LOCK_STRATEGY=redis-lock
